<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store: App Sandbox. Nur was Klassentakt braucht. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <!-- Dokumentenkamera und Ruhe-Timer -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Dateien hochladen und Downloads speichern (nur über den Datei-Dialog) -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.print</key><true/>
  <!-- Electron braucht eine App-Gruppe für die Prozesse untereinander -->
  <key>com.apple.security.application-groups</key>
  <array><string>Z28KL39TYK.ch.klassentakt.app</string></array>
  <!-- TestFlight / App Store -->
  <key>com.apple.application-identifier</key><string>Z28KL39TYK.ch.klassentakt.app</string>
  <key>com.apple.developer.team-identifier</key><string>Z28KL39TYK</string>
</dict>
</plist>
