{
  "name": "klassentakt-app",
  "productName": "Klassentakt",
  "version": "0.4.1",
  "description": "Klassentakt als Mac-App: Planung und Classroom Screen.",
  "author": "Florian Winberger",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/beamer.js && node --check src/updater.js && node --check src/update-preload.js && node --check src/ink.js && node --check src/server.js",
    "dist:mac": "npm run build:ink && electron-builder --mac --publish never -c.mac.identity=-",
    "test": "node --test test/*.test.js",
    "dist:mas": "npm run build:ink && electron-builder --config build/electron-builder.mas.js --mac mas --universal --publish never",
    "build:ink": "scripts/build-ink.sh"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ch.klassentakt.app",
    "productName": "Klassentakt",
    "copyright": "© 2026 Florian Winberger",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "artifactName": "Klassentakt-${version}-mac.${ext}",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Klassentakt braucht das Mikrofon für den Ruhe-Timer.",
        "NSCameraUsageDescription": "Klassentakt braucht die Kamera für die Dokumentenkamera."
      }
    },
    "dmg": {
      "title": "Klassentakt ${version}",
      "artifactName": "Klassentakt-${version}.dmg"
    },
    "protocols": [
      {
        "name": "Klassentakt",
        "schemes": [
          "klassentakt"
        ]
      }
    ],
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "provisioningProfile": "build/mas.provisionprofile",
      "artifactName": "Klassentakt-${version}-mas.${ext}",
      "extendInfo": {
        "ElectronTeamID": "Z28KL39TYK",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extraResources": [
      {
        "from": "native/bin/kt-ink",
        "to": "kt-ink"
      }
    ]
  },
  "masVersion": "1.0.0"
}
